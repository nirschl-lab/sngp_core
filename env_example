# Example `.env` file for environment variables.
# Environment variables go here, can be read by `python-dotenv` package:
#
#   `src/script.py`
#   ----------------------------------------------------------------
#    import dotenv
#
#    project_dir = os.path.join(os.path.dirname(__file__), os.pardir)
#    dotenv_path = os.path.join(project_dir, '.env')
#    dotenv.load_dotenv(dotenv_path)
#   ----------------------------------------------------------------
#
# NEVER ADD THE `.env` FILE WITH SECRETS TO VERSION CONTROL!
LOGGING_LEVEL=INFO
PYTHONFAULTHANDLER=1

HYDRA_FULL_ERROR=1

# Where this project's logs/checkpoints/Hydra multirun output go:
# configs/paths/default.yaml resolves log_dir as ${EXPERIMENTS_HOME}/${PROJECT_NAME} --
# created automatically on first run if it doesn't exist yet. PROJECT_ROOT is NOT set
# here -- rootutils.setup_root() (called at the top of src/train.py etc.) detects it
# automatically from the repo's `.project-root` file and exports it itself.
EXPERIMENTS_HOME=<path, e.g. /data1/<you>/experiments>
PROJECT_NAME=<this project's folder name under EXPERIMENTS_HOME, e.g. sngp-core>

# Artifact simulation (only needed for `data=artifact_image_classifier`).
# BANK is the asset folder holding alpha/ and paired/; configs/paths/default.yaml exposes
# it as ${paths.artifact_bank_dir}. CACHE is read by histo-artifact-sim itself -- it is
# where the measured asset index is cached, so keep it off the project tree and somewhere
# writable and persistent.
HISTO_ARTIFACTS_BANK=<path to the artifact asset bank, e.g. /data1/shared/data/artifacts-org>
HISTO_ARTIFACTS_CACHE=<path, e.g. /data1/shared/.cache/histo-artifact-cache>

# Hugging Face cache -- read directly by the `datasets`/`huggingface_hub` libraries,
# no Hydra config involved. See configs/paths/default.yaml.
HF_TOKEN=<your-hf-api-token>
HF_HOME=<path>
HF_HUB_CACHE=<path>/hub
TRANSFORMERS_CACHE=<path>/transformers
HF_DATASETS_CACHE=<path>/datasets